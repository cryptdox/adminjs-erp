// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // previewFeatures = ["interactiveTransactions"]
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                       @id @default(uuid())
  firstName                  String?
  lastName                   String?
  userName                   String                       @unique
  email                      String                       @unique
  password                   String
  emailVerified              Boolean                      @default(true)
  isActive                   Boolean                      @default(true)
  isAllowed                  Boolean                      @default(true)
  isDeleted                  Boolean                      @default(false)
  deletedAt                  DateTime?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  roleId                     String?
  Role                       Role?                        @relation(fields: [roleId], references: [id])
  PurchaseOrderStatusHistory PurchaseOrderStatusHistory[]
  SaleOrderStatusHistory     SaleOrderStatusHistory[]
  Payment                    Payment[]
  AuditLog                   AuditLog[]
  Partner                    Partner?                     @relation
  StockExchange              StockExchange[]
  Expense                    Expense[]
  Invoice                    Invoice[]

  @@index([roleId], name: "IX_User_RoleId")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // e.g., "ADMIN", "MANAGER", "USER"
  description String?
  permissions RolePermission[]
  isActive    Boolean          @default(true)
  isAllowed   Boolean          @default(true)
  isDeleted   Boolean          @default(false)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  User        User[]
}

model Permission {
  id          String           @id @default(uuid())
  resource    String // e.g., "Product", "Invoice", "User"
  action      String // e.g., "create", "read", "update", "delete"
  description String?
  roles       RolePermission[]
  isActive    Boolean          @default(true)
  isAllowed   Boolean          @default(true)
  isDeleted   Boolean          @default(false)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([resource, action])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  isActive     Boolean    @default(true)
  isAllowed    Boolean    @default(true)
  isDeleted    Boolean    @default(false)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([roleId, permissionId])
}

// INVENTORY MANAGEMENT

model ProductCategory {
  id        String            @id @default(uuid())
  name      String
  parentId  String? // self-relation
  parent    ProductCategory?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryParent")
  products  Product[]
  isActive  Boolean           @default(true)
  isAllowed Boolean           @default(true)
  isDeleted Boolean           @default(false)
  deletedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

enum UnitGroup {
  WEIGHT
  VOLUME
  COUNT
}

model Unit {
  id          String     @id @default(uuid())
  name        String     @unique // "kg", "g", "liter", "ml", etc.
  label       String // "Kilogram", "Gram", etc.
  group       UnitGroup? // "weight", "volume", "count"
  isBase      Boolean    @default(false) // is it the base unit in its group?
  minValue    Float? // Optional: e.g., 0.5
  maxValue    Float? // Optional: e.g., 100
  step        Float? // e.g., 0.5, 1, 10 (for UI increment control)
  description String?
  isActive    Boolean    @default(true)
  isAllowed   Boolean    @default(true)
  isDeleted   Boolean    @default(false)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  conversionsFrom UnitConversion[] @relation("FromUnit")
  conversionsTo   UnitConversion[] @relation("ToUnit")
}

model UnitConversion {
  id         String   @id @default(uuid())
  fromUnitId String
  toUnitId   String
  multiplier Float // e.g., 1000 means 1 kg = 1000 g
  note       String? // Optional explanation
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fromUnit Unit @relation("FromUnit", fields: [fromUnitId], references: [id])
  toUnit   Unit @relation("ToUnit", fields: [toUnitId], references: [id])

  @@unique([fromUnitId, toUnitId])
}

model Product {
  id         String           @id @default(uuid())
  name       String
  sku        String?
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])
  isActive   Boolean          @default(true)
  isAllowed  Boolean          @default(true)
  isDeleted  Boolean          @default(false)
  deletedAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  Variant    Variant[]

  @@index([name])
}

model Variant {
  id            String          @id @default(uuid())
  name          String?
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  attributes    Json // e.g., { size: "M", color: "Red" }
  isActive      Boolean         @default(true)
  isAllowed     Boolean         @default(true)
  isDeleted     Boolean         @default(false)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  StockExchange StockExchange[]
}

model Warehouse {
  id            String          @id @default(uuid())
  name          String
  location      String? // Address or description
  contact       String? // Phone or email
  capacity      Int? // Optional max capacity (units)
  isActive      Boolean         @default(true)
  isAllowed     Boolean         @default(true)
  isDeleted     Boolean         @default(false)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  StockExchange StockExchange[]
}

model Batch {
  id              String          @id @default(uuid())
  batchNumber     String // Unique batch or lot number
  manufactureDate DateTime?
  expiryDate      DateTime?
  isActive        Boolean         @default(true)
  isAllowed       Boolean         @default(true)
  isDeleted       Boolean         @default(false)
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  StockExchange   StockExchange[]
}

model Lot {
  id            String          @id @default(uuid())
  lotNumber     String // Unique lot identifier
  isActive      Boolean         @default(true)
  isAllowed     Boolean         @default(true)
  isDeleted     Boolean         @default(false)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  StockExchange StockExchange[]
}

// enum StockExchangeType {
//   PURCHASE_IN // StockExchange added via purchase order
//   RETURN_IN // StockExchange returned from customer
//   ADJUSTMENT_IN // StockExchange added by manual adjustment
//   SALE_OUT // StockExchange sold to customer
//   DAMAGE_OUT // StockExchange lost/damaged
//   TRANSFER_IN // StockExchange received from another warehouse
//   TRANSFER_OUT // StockExchange sent to another warehouse
//   ADJUSTMENT_OUT // StockExchange reduced by manual adjustment
// }
model StockExchangeType {
  id          String    @id @default(uuid())
  code        String    @unique // e.g., "PURCHASE_IN", "SALE_OUT"
  name        String // e.g., "Purchase In", "Sale Out"
  description String?
  isActive    Boolean   @default(true)
  isAllowed   Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stocks StockExchange[]
}

model StockExchangeStatus {
  id          String          @id @default(uuid())
  name        String          @unique // e.g., "in_stock", "reserved", "damaged", "returned"
  displayName String // e.g., "In StockExchange", "Damaged"
  description String?
  isActive    Boolean         @default(true)
  isAllowed   Boolean         @default(true)
  isDeleted   Boolean         @default(false)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  stocks      StockExchange[]
}

model StockExchange {
  id                    String               @id @default(uuid())
  productVariantId      String
  productVariant        Variant              @relation(fields: [productVariantId], references: [id])
  warehouseId           String
  warehouse             Warehouse            @relation(fields: [warehouseId], references: [id])
  lotId                 String? // Optional lot tracking
  lot                   Lot?                 @relation(fields: [lotId], references: [id])
  batchId               String? // Optional batch tracking
  batch                 Batch?               @relation(fields: [batchId], references: [id])
  note                  String?
  quantity              Int                  @default(0)
  isActive              Boolean              @default(true)
  isAllowed             Boolean              @default(true)
  isDeleted             Boolean              @default(false)
  deletedAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  ManufactureInput      ManufactureInput[]
  ManufactureOutput     ManufactureOutput[]
  InvoiceItem           InvoiceItem[]
  CreatedBy             User?                @relation(fields: [createdById], references: [id])
  createdById           String?
  StockExchangeStatus   StockExchangeStatus? @relation(fields: [stockExchangeStatusId], references: [id])
  stockExchangeStatusId String?
  StockExchangeType     StockExchangeType?   @relation(fields: [stockExchangeTypeId], references: [id])
  stockExchangeTypeId   String?

  @@index([stockExchangeTypeId, warehouseId])
}

// MANUFACTURE MANAGEMENT

model Manufacture {
  id          String    @id @default(uuid())
  type        String // "combine" বা "split"
  startedAt   DateTime
  completedAt DateTime?
  note        String?
  isActive    Boolean   @default(false)
  isAllowed   Boolean   @default(false)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  inputs  ManufactureInput[]
  outputs ManufactureOutput[]
}

model ManufactureInput {
  id            String        @id @default(uuid())
  manufactureId String
  manufacture   Manufacture   @relation(fields: [manufactureId], references: [id])
  stockId       String
  stockExchange StockExchange @relation(fields: [stockId], references: [id])
  isActive      Boolean       @default(false)
  isAllowed     Boolean       @default(false)
  isDeleted     Boolean       @default(false)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ManufactureOutput {
  id            String        @id @default(uuid())
  manufactureId String
  manufacture   Manufacture   @relation(fields: [manufactureId], references: [id])
  stockId       String
  stockExchange StockExchange @relation(fields: [stockId], references: [id])
  isActive      Boolean       @default(false)
  isAllowed     Boolean       @default(false)
  isDeleted     Boolean       @default(false)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Accounts

// 🔑 Common types:
// asset – cash, bank
// liability – supplier dues, loans
// equity – owner capital
// revenue – sales income
// expense – rent, salary
model AccountType {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  parentId    String? // self-reference
  parent      AccountType?  @relation("AccountTypeHierarchy", fields: [parentId], references: [id])
  children    AccountType[] @relation("AccountTypeHierarchy")
  accounts    Account[]
  isActive    Boolean       @default(true)
  isAllowed   Boolean       @default(true)
  isDeleted   Boolean       @default(false)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Account {
  id                   String        @id @default(uuid())
  name                 String
  typeId               String
  type                 AccountType   @relation(fields: [typeId], references: [id])
  balance              Decimal       @default(0.0)
  isDefault            Boolean       @default(false)
  isActive             Boolean       @default(true)
  isAllowed            Boolean       @default(true)
  isDeleted            Boolean       @default(false)
  deletedAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  sentTransactions     Transaction[] @relation("TransactionFromAccount")
  receivedTransactions Transaction[] @relation("TransactionToAccount")
  LedgerEntry          LedgerEntry[]
  Invoice              Invoice[]
  Partner              Partner[]
}

model Transaction {
  id            String        @id @default(uuid())
  fromAccountId String
  toAccountId   String
  amount        Decimal       @default(0.0)
  type          String // e.g. "sale", "payment", "withdraw", "purchase"
  // referenceId     String? // optional: link to invoice, purchase, etc.
  note          String?
  isActive      Boolean       @default(true)
  isAllowed     Boolean       @default(true)
  isDeleted     Boolean       @default(false)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  fromAccount   Account       @relation("TransactionFromAccount", fields: [fromAccountId], references: [id])
  toAccount     Account       @relation("TransactionToAccount", fields: [toAccountId], references: [id])
  LedgerEntry   LedgerEntry[]
  Invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  invoiceId     String?
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

model LedgerEntry {
  id            String          @id @default(uuid())
  accountId     String
  account       Account         @relation(fields: [accountId], references: [id])
  transactionId String
  transaction   Transaction     @relation(fields: [transactionId], references: [id])
  type          LedgerEntryType // "debit" or "credit"
  amount        Decimal
  balanceAfter  Decimal // optional: running balance after this entry
  note          String?
  isActive      Boolean         @default(true)
  isAllowed     Boolean         @default(true)
  isDeleted     Boolean         @default(false)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum PartnerType {
  SUPPLIER
  CUSTOMER
  SHAREHOLDER
}

model Partner {
  id                     String                  @id @default(uuid())
  name                   String
  type                   PartnerType
  email                  String?                 @unique
  phone                  String?
  address                String?
  nid                    String? // Optional: for shareholder KYC
  userId                 String?                 @unique
  user                   User?                   @relation(fields: [userId], references: [id])
  isActive               Boolean                 @default(true)
  isAllowed              Boolean                 @default(true)
  isDeleted              Boolean                 @default(false)
  deletedAt              DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  account                Account?                @relation(fields: [accountId], references: [id])
  accountId              String?
  ShareHolderProfitShare ShareHolderProfitShare?
  PurchaseOrder          PurchaseOrder[]
  SaleOrder              SaleOrder[]
  Expense                Expense[]
}

// FINANCE MANAGEMENT

// enum InvoiceType {
//   STOCK_SALES
//   STOCK_PURCHASE
//   OTHER_SALES
//   OTHER_PURCHASE
//   EXPENSE
// }

// enum InvoiceStatus {
//   UNPAID
//   PARTIAL
//   PAID
//   CANCELLED
// }

model ShareHolderProfitShare {
  id           String    @id @default(uuid())
  partnerId    String    @unique
  partner      Partner   @relation(fields: [partnerId], references: [id])
  month        Int // 1-12
  year         Int
  sharePercent Decimal // e.g., 15.00 means 15%
  isActive     Boolean   @default(true)
  isAllowed    Boolean   @default(true)
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model InvoiceType {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  isAllowed   Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Invoice     Invoice[]
}

model Invoice {
  id              String         @id @default(uuid())
  invoiceNumber   String         @unique
  invoiceTypeId   String // "SALES" or "PURCHASE" or "EXPENSE"
  invoiceType     InvoiceType    @relation(fields: [invoiceTypeId], references: [id]) // "SALES" or "PURCHASE" or "EXPENSE"
  accountId       String // Customer (for SALES) or Supplier (for PURCHASE or EXPENSE)
  account         Account        @relation(fields: [accountId], references: [id])
  invoiceDate     DateTime
  dueDate         DateTime?
  totalAmount     Decimal        @default(0.0)
  paidAmount      Decimal        @default(0.0)
  note            String?
  discount        Decimal?
  discountType    DiscountType   @default(AMOUNT)
  isActive        Boolean        @default(true)
  isAllowed       Boolean        @default(true)
  isDeleted       Boolean        @default(false)
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  CreatedBy       User?          @relation(fields: [userId], references: [id])
  items           InvoiceItem[]
  transactions    Transaction[] // optional: payments made
  PurchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String?
  SaleOrder       SaleOrder?     @relation(fields: [saleOrderId], references: [id])
  saleOrderId     String?
  Expense         Expense[]
  userId          String?
}

enum DiscountType {
  PERCENT
  AMOUNT
}

model InvoiceItem {
  id            String         @id @default(uuid())
  name          String?
  invoiceId     String
  invoice       Invoice        @relation(fields: [invoiceId], references: [id])
  stockId       String // Optional: only for SALES and PURCHASE
  stockExchange StockExchange? @relation(fields: [stockId], references: [id])
  unitPrice     Decimal?
  discount      Decimal?
  discountType  DiscountType   @default(AMOUNT)
  note          String?
  isActive      Boolean        @default(true)
  isAllowed     Boolean        @default(true)
  isDeleted     Boolean        @default(false)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  Expense       Expense[]

  @@index([invoiceId])
}

model OrderStatus {
  id                         String                       @id @default(uuid())
  name                       String                       @unique // e.g., "pending", "partial", "completed", "cancelled"
  displayName                String // e.g., "Pending", "Partially Fulfilled"
  description                String?
  isActive                   Boolean                      @default(true)
  isAllowed                  Boolean                      @default(true)
  isDeleted                  Boolean                      @default(false)
  deletedAt                  DateTime?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  PurchaseOrderStatusHistory PurchaseOrderStatusHistory[]
  SaleOrderStatusHistory     SaleOrderStatusHistory[]
}

model PurchaseOrder {
  id                         String                       @id @default(uuid())
  orderNumber                String                       @unique
  partnerId                  String
  partner                    Partner                      @relation(fields: [partnerId], references: [id])
  orderDate                  DateTime
  note                       String?
  isActive                   Boolean                      @default(true)
  isAllowed                  Boolean                      @default(true)
  isDeleted                  Boolean                      @default(false)
  deletedAt                  DateTime?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  invoices                   Invoice[]
  PurchaseOrderStatusHistory PurchaseOrderStatusHistory[]
}

model PurchaseOrderStatusHistory {
  id            String        @id @default(uuid())
  orderId       String
  purchaseOrder PurchaseOrder @relation(fields: [orderId], references: [id])
  statusId      String
  status        OrderStatus   @relation(fields: [statusId], references: [id])
  changedById   String? // optional: who changed it (User)
  changedBy     User?         @relation(fields: [changedById], references: [id])
  note          String?
  changedAt     DateTime      @default(now())
  isActive      Boolean       @default(true)
  isAllowed     Boolean       @default(true)
  isDeleted     Boolean       @default(false)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model SaleOrder {
  id                     String                   @id @default(uuid())
  orderNumber            String                   @unique
  partnerId              String
  partner                Partner                  @relation(fields: [partnerId], references: [id])
  orderDate              DateTime
  note                   String?
  isActive               Boolean                  @default(true)
  isAllowed              Boolean                  @default(true)
  isDeleted              Boolean                  @default(false)
  deletedAt              DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  invoices               Invoice[]
  SaleOrderStatusHistory SaleOrderStatusHistory[]
}

model SaleOrderStatusHistory {
  id          String      @id @default(uuid())
  orderId     String
  saleOrder   SaleOrder   @relation(fields: [orderId], references: [id])
  statusId    String
  status      OrderStatus @relation(fields: [statusId], references: [id])
  changedById String? // optional: who changed it (User)
  changedBy   User?       @relation(fields: [changedById], references: [id])
  note        String?
  changedAt   DateTime    @default(now())
  isActive    Boolean     @default(true)
  isAllowed   Boolean     @default(true)
  isDeleted   Boolean     @default(false)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ExpenseType {
  id          String    @id @default(uuid())
  name        String    @unique // e.g., "PURCHASE", "SALE", "RETURN"
  displayName String // e.g., "Purchase Order", "Sales Order"
  description String?
  isActive    Boolean   @default(true)
  isAllowed   Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Expense     Expense[]
}

model Expense {
  id              String        @id @default(uuid())
  orderNumber     String
  expenseTypeId   String
  expenseType     ExpenseType   @relation(fields: [expenseTypeId], references: [id])
  partnerId       String
  partner         Partner       @relation(fields: [partnerId], references: [id])
  orderDate       DateTime
  note            String?
  isActive        Boolean       @default(true)
  isAllowed       Boolean       @default(true)
  isDeleted       Boolean       @default(false)
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  userId          String?
  CreatedBy       User?         @relation(fields: [userId], references: [id])
  expenseStatusId String
  ExpenseStatus   ExpenseStatus @relation(fields: [expenseStatusId], references: [id])
  invoiceId       String?
  Invoice         Invoice?      @relation(fields: [invoiceId], references: [id])
  invoiceItemId   String?
  InvoiceItem     InvoiceItem?  @relation(fields: [invoiceItemId], references: [id])
}

model ExpenseStatus {
  id          String    @id @default(uuid())
  name        String    @unique // e.g., "pending", "partial", "completed", "cancelled"
  displayName String // e.g., "Pending", "Partially Fulfilled"
  description String?
  isActive    Boolean   @default(true)
  isAllowed   Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Expense     Expense[]
}

// enum PaymentStatus {
//   PENDING
//   COMPLETED
//   FAILED
//   CANCELLED
//   REFUNDED
// }

// enum RelatedType {
//   PURCHASE_ORDER
//   SALE_ORDER
//   EXPENSE
// }

model PaymentStatus {
  id          String  @id @default(uuid())
  code        String  @unique // e.g., "PENDING", "COMPLETED"
  label       String // e.g., "Pending", "Payment Complete"
  description String?
  color       String? // Optional: UI indicator (e.g., "#facc15")

  payments Payment[] @relation("StatusRelation")
}

model RelatedType {
  id          String  @id @default(uuid())
  code        String  @unique // e.g., "PURCHASE_ORDER"
  label       String // e.g., "Purchase Order"
  description String?

  payments Payment[] @relation("RelatedTypeRelation")
}

model Payment {
  id            String        @id @default(uuid())
  amount        Float
  currency      String        @default("BDT")
  paymentMethod String
  paidAt        DateTime?
  referenceNo   String?
  note          String?
  statusId      String
  status        PaymentStatus @relation("StatusRelation", fields: [statusId], references: [id])
  relatedTypeId String
  relatedType   RelatedType   @relation("RelatedTypeRelation", fields: [relatedTypeId], references: [id])
  relatedId     String // ID from referenced table
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id])
  isActive      Boolean       @default(true)
  isAllowed     Boolean       @default(true)
  isDeleted     Boolean       @default(false)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// PLATFORM MANAGEMENT

model AuditLog {
  id            String  @id @default(uuid())
  action        String // e.g., "CREATE", "UPDATE", "DELETE", "LOGIN"
  entity        String // e.g., "User", "Order", "Product"
  entityId      String? // ID of the affected entity (optional)
  description   String? // Summary or notes about the action
  data          Json? // Old/new values or any payload
  ipAddress     String? // User's IP
  userAgent     String? // Device/browser info
  // Actor info
  performedById String?
  performedBy   User?   @relation(fields: [performedById], references: [id])

  createdAt DateTime @default(now())
}

// enum SettingType {
//   TEXT        // default string
//   NUMBER
//   BOOLEAN
//   DATE
//   JSON
//   SELECT      // when a dropdown is needed
// }

model SettingOption {
  id        String    @id @default(uuid())
  label     String // e.g., "BDT", "USD", "EUR"
  value     String // e.g., "bdt", "usd", "eur"
  settingId String
  setting   Setting   @relation(fields: [settingId], references: [id])
  sortOrder Int       @default(0) // Optional: control order of display
  isActive  Boolean   @default(true)
  isAllowed Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SettingType {
  id          String    @id @default(uuid())
  name        String    @unique // e.g., "TEXT", "NUMBER", "BOOLEAN"
  label       String // e.g., "Text", "Number", "Yes/No"
  description String? // Optional: how to use this type
  uiComponent String? // Optional: "input", "switch", "select", etc.
  settings    Setting[] // Back reference
  isActive    Boolean   @default(true)
  isAllowed   Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Setting {
  id          String          @id @default(uuid())
  key         String          @unique
  value       String
  typeId      String
  type        SettingType     @relation(fields: [typeId], references: [id])
  options     SettingOption[]
  group       String?
  description String?
  isEditable  Boolean         @default(true)
  isVisible   Boolean         @default(true)
  isActive    Boolean         @default(true)
  isAllowed   Boolean         @default(true)
  isDeleted   Boolean         @default(false)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}
